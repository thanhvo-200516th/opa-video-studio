{
  "name": "OPA Design System",
  "version": "1.0.0",
  "brand": "OverPowers Agency (OPA)",
  "colors": {
    "primary": {
      "default": "#0068FF",
      "hover": "#0052CC",
      "dark": "#003C99",
      "light": "#E6F0FF"
    },
    "neutral": {
      "black": "#0A0A0A",
      "white": "#FFFFFF",
      "surface": "#F8FAFC",
      "border": "#E2E8F0",
      "muted": "#64748B"
    }
  },
  "contrastRules": {
    "mascotOn": {
      "white": "#0068FF",
      "light": "#0068FF",
      "blue": "#FFFFFF",
      "dark": "#FFFFFF",
      "black": "#FFFFFF"
    },
    "textOn": {
      "blue": "#FFFFFF",
      "dark": "#FFFFFF",
      "white": "#0A0A0A",
      "light": "#0A0A0A"
    }
  },
  "typography": {
    "primaryFont": "'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "accentFont": "'Fraunces', serif",
    "scale": {
      "display": { "size": "48px", "weight": "800", "lineHeight": "1.15" },
      "h1": { "size": "36px", "weight": "800", "lineHeight": "1.2" },
      "h2": { "size": "28px", "weight": "700", "lineHeight": "1.25" },
      "h3": { "size": "20px", "weight": "700", "lineHeight": "1.3" },
      "body": { "size": "15px", "weight": "500", "lineHeight": "1.5" },
      "bodySmall": { "size": "13px", "weight": "400", "lineHeight": "1.45" },
      "caption": { "size": "11px", "weight": "500", "lineHeight": "1.4" }
    }
  },
  "radii": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "motion": {
    "easeIn": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "easeOut": "cubic-bezier(0.6, 0, 0.8, 0.2)",
    "springPop": {
      "damping": 12,
      "stiffness": 100,
      "mass": 1
    }
  }
}